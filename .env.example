# API configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Toggle between mock data ("true") and the real backend API ("false")
NEXT_PUBLIC_USE_MOCKS=true

# Mock scenario toggles (used only when NEXT_PUBLIC_USE_MOCKS=true)
# Allowed values: "0" | "3"
NEXT_PUBLIC_MOCK_ADS=3
# Allowed values: "none" | "some"
NEXT_PUBLIC_MOCK_EVENTS=some

# Public canonical URL of this frontend (used for metadata, OG tags, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional comma-separated list of remote image hostnames allowed in next/image and CSP
# Example: cdn.cinevanta.in,images.cinevanta.in
NEXT_PUBLIC_IMAGE_HOSTS=

